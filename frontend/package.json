{
  "name": "ainp-frontend",
  "version": "0.1.0",
  "description": "AINP - AI Native Enterprise SaaS Platform",
  "keywords": [
    "AINP",
    "TypeScript",
    "UnoCSS",
    "Vite",
    "Vue3",
    "naive-ui",
    "soybean-admin"
  ],
  "homepage": "https://github.com/yzxingtu2026/ainp",
  "bugs": {
    "url": "https://github.com/yzxingtu2026/ainp/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "baseline:generate": "node scripts/admin-baseline.mjs generate",
    "baseline:verify": "node scripts/admin-baseline.mjs verify",
    "build": "vite build --mode prod",
    "build:downstream-example": "AINP_ADMIN_APPLICATION=./examples/downstream-admin/application.ts AINP_ADMIN_MODULES=core,system,ai vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "fmt": "oxfmt",
    "gen-route": "sa gen-route",
    "lint": "oxlint --fix && eslint --fix .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "test:app-select-architecture": "node scripts/check-app-select.mjs",
    "test:attachment-picker": "tsx --test src/components/common/attachment-thumb-poll.test.ts",
    "test:attachment-preview": "vitest run --config vitest.config.ts src/hooks/business/attachment-preview.test.ts && node --test scripts/check-attachment-preview.test.mjs && node scripts/check-attachment-preview.mjs",
    "test:composer": "vitest run --config vitest.config.ts src/views/ai/workspace/modules/workspace-composer.test.ts && tsx --test src/views/ai/workspace/modules/clipboard-image.test.ts src/components/ai/run-failure-message.test.ts src/components/ai/run-terminal-notice.test.ts",
    "test:composition": "tsx --test src/composition/define-app.test.ts src/composition/platform-layouts.test.ts src/composition/profile-extension.test.ts && vitest run --config vitest.config.ts src/views/system/profile/profile-extension-host.test.ts src/layouts/modules/global-header/components/shell-extension-host.test.ts src/layouts/modules/global-header/components/shell-extension-region.test.ts",
    "test:downstream-build": "pnpm build:downstream-example && ! rg -l 'demo-task-1|/api/v1/demo/hello' dist",
    "test:list-page-overflow": "node --test scripts/check-list-page-overflow.test.mjs && node scripts/check-list-page-overflow.mjs",
    "test:menu": "tsx --test src/store/modules/route/shared.test.ts",
    "test:redirect-auth": "tsx --test src/utils/auth-redirect.test.ts",
    "test:request-error-boundary": "tsx --test src/service/request/error.test.ts && node --test scripts/check-request-error-boundary.test.mjs && node scripts/check-request-error-boundary.mjs",
    "test:select": "vitest run --config vitest.config.ts src/components/common/app-select.test.ts",
    "test:service-url": "tsx --test src/utils/service.test.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@iconify/vue": "5.0.1",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "14.3.0",
    "axios": "1.16.0",
    "clipboard": "2.0.11",
    "codemirror": "^6.0.2",
    "dayjs": "1.11.20",
    "defu": "6.1.7",
    "dompurify": "^3.4.12",
    "echarts": "6.0.0",
    "json5": "2.2.3",
    "marked": "^18.0.6",
    "naive-ui": "2.44.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.34",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.2",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@iconify/utils": "3.1.3",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "^0.0.2",
    "@types/node": "25.7.0",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/compiler-dom": "3.5.34",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/test-utils": "^2.4.11",
    "consola": "3.4.2",
    "eslint": "10.3.0",
    "happy-dom": "^20.11.1",
    "kolorist": "1.8.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "sass": "1.99.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.12",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.2",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "3.2.8"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint && pnpm fmt && git diff --exit-code"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  },
  "website": "https://github.com/yzxingtu2026/ainp"
}
