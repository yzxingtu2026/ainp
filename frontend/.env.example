# Copy to .env / .env.test as needed. Root gitignore keeps secrets out; these templates are tracked.

VITE_BASE_URL=/
VITE_APP_TITLE=AINP
VITE_APP_DESC=AINP Admin
# Release builds inject one Git Tag, commit and UTC RFC3339 timestamp into all artifacts.
VITE_BUILD_VERSION=dev
VITE_BUILD_COMMIT=unknown
VITE_BUILD_TIME=unknown
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_AUTH_ROUTE_MODE=dynamic
VITE_ROUTE_HOME=home
VITE_MENU_ICON=mdi:menu
VITE_HTTP_PROXY=Y
VITE_ROUTER_HISTORY_MODE=history
VITE_SERVICE_SUCCESS_CODE=0
VITE_SERVICE_LOGOUT_CODES=
VITE_SERVICE_MODAL_LOGOUT_CODES=
VITE_SERVICE_EXPIRED_TOKEN_CODES=10002
VITE_STATIC_SUPER_ROLE=R_SUPER
VITE_SOURCE_MAP=N
VITE_STORAGE_PREFIX=AINP_
VITE_AUTOMATICALLY_DETECT_UPDATE=Y
VITE_PROXY_LOG=Y
VITE_DEVTOOLS_LAUNCH_EDITOR=code

# 指向本地 platform（见 platform/README.md）
VITE_SERVICE_BASE_URL=http://127.0.0.1:8080
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://127.0.0.1:8080"
}`
