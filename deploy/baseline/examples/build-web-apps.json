{
  "schema": 1,
  "project": "example-app",
  "go_dir": "backend",
  "commands": {
    "api": "./cmd/api",
    "worker": "./cmd/worker",
    "migrate": "./cmd/migrate"
  },
  "buildinfo_package": "github.com/yzxingtu2026/ainp/platform/framework/buildinfo",
  "cjk_test_package": "github.com/yzxingtu2026/ainp/platform/contracts/pdfcjk",
  "node_version": "22.22.0",
  "pnpm_version": "10.26.2",
  "admin_application": "./src/composition/application.ts",
  "admin_modules": [
    "core",
    "system",
    "operations",
    "ai",
    "demo"
  ],
  "go_private": [],
  "web_apps": [
    {
      "name": "admin",
      "source_dir": "admin",
      "mount": "/",
      "build_command": [
        "pnpm",
        "build"
      ],
      "health_path": "/build.json"
    },
    {
      "name": "screen",
      "source_dir": "apps/bigscreen",
      "mount": "/bigscreen/",
      "build_command": [
        "pnpm",
        "build:screen"
      ],
      "build_env": {
        "VITE_SCREEN": "yes"
      },
      "health_path": "/bigscreen/build.json"
    }
  ]
}
