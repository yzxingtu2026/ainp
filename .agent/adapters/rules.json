    },
    {
      "id": "settings-system",
      "source": ".agent/rules/settings-system.md",
      "qoder": {
        "path": ".qoder/rules/settings-system.md",
        "frontmatter": {
          "trigger": "always_on"
        }
      },
      "cursor": {
        "path": ".cursor/rules/settings-system.mdc",
