          "alwaysApply": true
        }
      }
    },
    {
      "id": "auth-context",
      "source": ".agent/rules/auth-context.md",
      "qoder": {
        "path": ".qoder/rules/auth-context.md",
        "frontmatter": {
          "trigger": "always_on"
        }
      },
      "cursor": {
        "path": ".cursor/rules/auth-context.mdc",
        "frontmatter": {
          "description": "多租户与鉴权：Token 定租户、一用户一租户、Role-permission",
          "alwaysApply": true
        }
      }
    },
    {
      "id": "audit",
      "source": ".agent/rules/audit.md",
      "qoder": {
        "path": ".qoder/rules/audit.md",
        "frontmatter": {
          "trigger": "always_on"
        }
      },
      "cursor": {
        "path": ".cursor/rules/audit.mdc",
        "frontmatter": {
          "description": "审计最小集与运行日志分离，Action 链统一写入",
