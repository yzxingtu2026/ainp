        }
      }
    },
    {
      "id": "code-sets-and-status",
      "source": ".agent/rules/code-sets-and-status.md",
      "qoder": {
        "path": ".qoder/rules/code-sets-and-status.md",
        "frontmatter": {
          "trigger": "always_on"
        }
      },
      "cursor": {
        "path": ".cursor/rules/code-sets-and-status.mdc",
