        }
      }
    },
    {
      "id": "backend-layout",
      "source": ".agent/rules/backend-layout.md",
      "qoder": {
        "path": ".qoder/rules/backend-layout.md",
        "frontmatter": {
          "trigger": "always_on"
        }
      },
      "cursor": {
        "path": ".cursor/rules/backend-layout.mdc",
